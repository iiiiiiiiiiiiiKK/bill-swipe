# ---------------------------------------------------------------------------
# BILL SWIPE — environment variables
#
# Copy to `.dev.vars` for local development, or set them as Cloudflare Worker
# secrets for a deployment:  npx wrangler secret put NAME
#
# Nothing here is required to run the app in its default sandbox configuration.
# ---------------------------------------------------------------------------

# Runtime mode: "production" enables Secure cookies. Use "development" locally.
ENVIRONMENT=development

# Payment mode. Only "sandbox" is implemented and verified.
#   sandbox — simulated settlement, clearly labelled in the UI (default)
#   stripe  — reserved: requires STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET and
#             the webhook route to be implemented before enabling.
PAYMENT_MODE=sandbox

# Public origin used for links and cookies.
APP_ORIGIN=http://localhost:8787

# Secret used to sign the internal Worker <-> Durable Object RPC channel and to
# salt IP hashes used by the rate limiter. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Platform fee in basis points applied to help amounts (0 = no fee).
PLATFORM_FEE_BPS=0

# Seed the labelled demo dataset on first boot. Set to "false" for a clean,
# member-only deployment (the first registered user is not auto-promoted).
ALLOW_DEMO_SEED=true

# Bootstrap admin account created during seeding. Rotate before any real use.
ADMIN_EMAIL=admin@billswipe.local
ADMIN_PASSWORD=BillSwipe!Admin2026

# --- Optional: real payment provider (not enabled in this build) ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: transactional email -----------------------------------------
# When unset, notification emails are queued in the email_outbox table instead
# of being delivered. No third-party call is made.
RESEND_API_KEY=

# --- Rate limits (optional overrides) ---------------------------------------
# Requests per window, keyed by user (or IP when anonymous). Defaults shown in
# comments are the production-safe values in src/worker/api.ts.
# RL_REGISTER=10        # per hour
# RL_LOGIN=20           # per 15 minutes
# RL_PAYMENT_INTENT=30  # per 10 minutes
# RL_RECEIPT_UPLOAD=20  # per hour

# --- Debug ------------------------------------------------------------------
# "true" returns exception messages in API error responses. Never enable this in
# a public deployment.
DEBUG_ERRORS=false
