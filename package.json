{
  "name": "billswipe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Swipe a bill, change a life. A swipe-to-help bill crowdfunding app on Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "domain:attach": "node scripts/attach-domain.mjs",
    "shots": "node scripts/screenshots.mjs https://billswipe.852367856.dpdns.org docs/screenshots",
    "audit:i18n": "node scripts/audit-i18n.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.3"
  }
}
